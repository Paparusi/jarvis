# === JARVIS v2 Configuration ===

# LLM Provider (required)
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Database
DATABASE_URL=postgresql://jarvis:jarvis@localhost:5432/jarvis

# Redis
